    {{ define "counter.tmpl"}}
    {{ template "header.tmpl" . }}

    <div class="modal" id="deleteReset">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delete Reset?</h5>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to delete this reset? You can always create a Reset with identical traits later.</p>
          </div>
          <div class="modal-footer">
            <form id="delete-reset-form" class="needs-validation" novalidate>
                <input type="hidden" id="reset-modal-reset-id" name="resetId" value="">
                <input type="hidden" id="reset-modal-counter-id" name="counterId" value="">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>            
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div class="modal" id="deleteCounter">
      <div class="modal-dialog" role="document">
        <div class="modal-content">
          <div class="modal-header">
            <h5 class="modal-title">Delete Counter?</h5>
          </div>
          <div class="modal-body">
            <p>Are you sure you want to delete this reset? This action is <strong>permanent.</strong> Are you sure you want to proceed with this?</p>
          </div>
          <div class="modal-footer">
            <form id="delete-counter-form" class="needs-validation" novalidate>
                <input type="hidden" id="counter-modal-counter-id" name="counterId" value="">
                <button type="submit" class="btn btn-danger">Delete</button>
            </form>            
            <button type="button" class="btn btn-primary" data-bs-dismiss="modal">Cancel</button>
          </div>
        </div>
      </div>
    </div>

    <div class="container main p-3">
      <h2 class="text-center text-break display-4">Days Since {{.Title}}</h2>
      <h6 class="text-center text-break"><i>{{.Description}}</i></h6>
      <h1 class="text-center days-since display-1 fw-bold" data-timestamp="{{ .Timestamp }}"> </h1>

      <form action="/reset/{{.Id}}" method="GET" class="w-50 mx-auto">
        <input type="submit" class="btn btn-primary my-2 mx-auto" value="Reset">
     
        {{if or .EBoard .RTP (eq .UserID .CounterID)}}
          <button type="button" data-bs-toggle="modal" data-counter-id="{{ $.Id }}" data-bs-target="#deleteCounter" class="btn btn-danger ms-4">DELETE</button>
        {{end}} 
      </form>
      <br/>
      <div>
          <ul class="list-group list-unstyled text-wrap text-break w-75 mx-auto">
              {{ range $i, $reset := .History }}
                {{if or $.EBoard $.RTP (eq $.UserID $reset.ResetOwner)}}
                  <li class="p-2">
                      <div class="list-group-item p-2">
                        <div class="container">
                          <div class="row border-bottom mb-2 pb-2">
                            <div class="col d-flex flex-column justify-content-center">
                              <div class="text-center my-auto">
                                <span class="fs-5">{{ $reset.ResetDescription }}</span>
                                <br/>
                                <span class="description"><i>reported by: {{ $reset.ResetUsername }}</i></span>
                              </div>
                            </div>
                            <div class="col">
                              <div class="text-center my-auto">
                                <span class="days-since fw-bold display-3" data-timestamp="{{ $reset.ResetOccuredAt }}"> </span>
                                <span class="description d-block">Day(s) Ago</span>
                              </div>
                            </div>
                          </div>
                        </div>
                        <div class="row">
                          <div class="col-12">
                            <button type="button" data-bs-toggle="modal" data-reset-id="{{ $reset.ResetID }}" data-counter-id="{{ $.Id }}" data-bs-target="#deleteReset" class="btn btn-danger">DELETE</button>
                          </div>
                        </div>
                      </div>
                  </li>
                {{else}}
                    <li class="p-2">
                      <div class="list-group-item p-2">
                        <div class="container">
                          <div class="row border-bottom mb-2 pb-2">
                            <div class="col d-flex flex-column justify-content-center">
                              <div class="text-center my-auto">
                                <span class="fs-5">{{ $reset.ResetDescription }}</span>
                                <br/>
                                <span class="description"><i>reported by: {{ $reset.ResetUsername }}</i></span>
                              </div>
                            </div>
                            <div class="col">
                              <div class="text-center my-auto">
                                <span class="days-since fw-bold display-3" data-timestamp="{{ $reset.ResetOccuredAt }}"> </span>
                                <span class="description d-block">Day(s) Ago</span>
                              </div>
                            </div>
                          </div>
                        </div>
                      </div>
                  </li>
                {{end}}
              {{ end }}
          </ul>
      </div>
    </div>
  <script>
    (() => {
		'use strict'

    document.getElementById("deleteReset").addEventListener("show.bs.modal", function(event) {
        let button = event.relatedTarget
        document.getElementById("reset-modal-reset-id").value = button.getAttribute("data-reset-id")
        document.getElementById("reset-modal-counter-id").value = button.getAttribute("data-counter-id")
    })

    document.getElementById("deleteCounter").addEventListener("show.bs.modal", function(event) {
        let button = event.relatedTarget
        document.getElementById("counter-modal-counter-id").value = button.getAttribute("data-counter-id")
    })

    
    const delete_reset_form = document.getElementById("delete-reset-form")
    delete_reset_form.addEventListener('submit', async event => {
      event.preventDefault(); 
      const button = delete_reset_form.querySelector('[type="submit"]');
      button.disabled = true;

      const data = Object.fromEntries(new FormData(delete_reset_form));

      try {
        const response = await fetch('/api/v1/reset', {
          method: 'DELETE',
          headers: {'Content-Type': 'application/json'},
          credentials: 'include',
          body: JSON.stringify({
            "reset_id": document.getElementById("reset-modal-reset-id").value,
          }),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        const result = await response.json();

        if (result) {
          window.location.replace("/counter/" + {{ $.Id }});
        } else {
          window.location.replace("/");        
        }

      } catch (err) {
        console.error('Error:', err);
        button.disabled = false;
      }
    });


    const delete_counter_form = document.getElementById("delete-counter-form")
    delete_counter_form.addEventListener('submit', async event => {
      event.preventDefault(); 
      const button = delete_counter_form.querySelector('[type="submit"]');
      button.disabled = true;

      const data = Object.fromEntries(new FormData(delete_counter_form));

      try {
        const response = await fetch('/api/v1/counter', {
          method: 'DELETE',
          headers: {'Content-Type': 'application/json'},
          credentials: 'include',
          body: JSON.stringify({
            "counter_id": document.getElementById("counter-modal-counter-id").value
          }),
        });

        if (!response.ok) throw new Error(`HTTP ${response.status}`);
        
        window.location.replace("/");

      } catch (err) {
        console.error('Error:', err);
        button.disabled = false;
      }
    });

    {{/* bindForm('delete-form',
      ({ counterId, resetId }) => request(`/api/v1/counter/${counterId}/reset/${resetId}`, 'DELETE'),
      () => location.reload());

    bindForm('delete-counter-form',
      ({ counterId }) => request(`/api/v1/counter/${counterId}`, 'DELETE'),
      () => { location.href = '/'; }); */}}

		document.querySelectorAll(".days-since").forEach(el => {
      const days = Math.floor((Date.now() - (el.dataset.timestamp*1000)) / 86400000);
			el.textContent = days;
		});
    })();
  </script>
  </body>
</html>
{{ end }}