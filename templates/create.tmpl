    {{ define "create.tmpl"}}
    {{ template "header.tmpl" . }}

    <div class="container main p-5">
      <h2 class="mb-4">Create Counter</h2>
        <form id="create-form" class="needs-validation" novalidate>
        <div class="input-group needs-validation">
          <label for="title" class="input-group-text required-label">Counter Title</label>
          <input
            type="text"
            class="form-control"
            id="title"
            name="title"
            placeholder="Days Since Last (DO NOT TYPE THE DAYS SINCE LAST ITS INCLUDED ALREADY!)"
            required
            pattern=".*\S.*"
          >
        </div>
        <div class="input-group my-3">
          <label for="description" class="input-group-text required-label">Tagline</label>
          <input
            type="text"
            id="description"
            name="description"
            class="form-control"
            placeholder="A little message underneath the title..."
            required
            pattern=".*\S.*"
          >
        </div>

        <h5 class="mt-4"><strong>First Reset</strong></h5>

        <div class="input-group needs-validation my-3">
          <label for="reset-description" class="input-group-text required-label">Event</label>
          <input
            type="text"
            class="form-control"
            id="reset-description"
            name="reset-description"
            placeholder="What happened"
            required
            pattern=".*\S.*"          >
        </div>
        <div class="input-group my-3">
          <label for="reset-time" class="input-group-text">Time</label>
            <input
              type="datetime-local"
              class="form-control"
              name="reset-time"
              id="reset-time"
            />
          </div>
        <input type="submit" class="btn btn-primary my-2" value="Create">
      </form>
    </div>
    <style>
      .required-label::after {
        content: " *";
        color: red;
      }
    </style>
    <script>
      (() => {
        'use strict'

        const input = document.getElementById("reset-time");

        const now = new Date();
        const local = new Date(now.getTime() - now.getTimezoneOffset() * 60000);
        const formatted = local.toISOString().slice(0, 16);

        input.value = formatted;
        
        const forms = document.querySelectorAll('.needs-validation')

        Array.from(forms).forEach(form => {
          form.addEventListener('submit', async event => {
            event.preventDefault()

            if (!form.checkValidity()) return;

            const data = Object.fromEntries(new FormData(form));
            const button = form.querySelector('[type="submit"]');
            if (button) button.disabled = true;

            const ms = new Date(data['reset-time']).getTime();
            const resetTime = Number.isNaN(ms) ? null : Math.floor(ms / 1000);

            const counterBody = {
              "title": data["title"],
              "description": data["description"]
            }

            const resetBody = {
              "counter_id": "test",
              "description": data["reset-description"],
              "reset_time": resetTime
              ? resetTime
              : null,
            }

            try {
              const response = await fetch('/api/v1/counter', {
                method: 'POST',
                headers: {'Content-Type': 'application/json'},
                credentials: 'include',
                body: JSON.stringify({
                  "counter": counterBody,
                  "reset": resetBody
                }),
              });

              if (!response.ok) throw new Error(`HTTP ${response.status}`);

              const result = await response.json();

              window.location.replace("/counter/" + result);
              
              form.reset();
              form.classList.remove('was-validated');
            } catch (err) {
              console.error('Error:', err);
            } finally {
              if (button) button.disabled = false;
            }
            form.classList.add('was-validated')
          }, false)
        })
      })()
    </script>
  </body>
</html>

{{end}}